# 复制为 vision/.env
#
# 只有「模型四项」是必须自己填的。
# 包名、设备、账号会自动从 ../.env（app-automation/.env）的
# ANDROID_APP_PACKAGE / ANDROID_UDID / QA_USERNAME / QA_PASSWORD 兜底，
# 不用在这里抄第二遍。下面留空即可。

# ---- 模型（四项，缺一不可）----
# 直连 DeepSeek：
# MIDSCENE_MODEL_BASE_URL="https://api.deepseek.com"
# MIDSCENE_MODEL_NAME="deepseek-flash"
#
# 第三方中转（POC 实测可用）：Base URL 必须带 /v1，不带会被 307 跳到登录页
# MIDSCENE_MODEL_BASE_URL="https://app.ppapi.us/v1"
# MIDSCENE_MODEL_NAME="deepseek-v4.1-flash"
#
# 官方 AppControlBench 成绩：豆包 Seed 2.1 Turbo 98% / Qwen3.7 Plus 97% / DeepSeek V4.1 Flash 90%。
# 预算够就用前两个，别用弱模型试出「能力下限」当成框架不行。
# MIDSCENE_MODEL_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# MIDSCENE_MODEL_NAME="doubao-seed-2-1-turbo-260628"
# MIDSCENE_MODEL_FAMILY="doubao-seed"
MIDSCENE_MODEL_BASE_URL=""
MIDSCENE_MODEL_API_KEY=""
MIDSCENE_MODEL_NAME=""
MIDSCENE_MODEL_FAMILY="deepseek"

# ---- 以下都可留空（自动从 app-automation/.env 兜底）----
# 需要覆盖时再取消注释。注意：**不要写成 KEY=""**，
# 空字符串在 Midscene 眼里是「已设置但无效」，会直接报错。
# EGO_APP_PACKAGE=""
# EGO_USERNAME=""
# EGO_PASSWORD=""
# MIDSCENE_ANDROID_DEVICE_ID=""

# ---- 可选 ----
# 报告目录，默认 vision/midscene_run/report/。报告含截图和账号密码，不要外发。
# 留空会报 "run directory must be a non-empty path"，所以整行注释掉，别写空值。
# MIDSCENE_RUN_DIR="/abs/path/to/reports"
