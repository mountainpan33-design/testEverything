# ===== App 自动化运行参数（复制为 .env 后填写，.env 不进 git）=====

# 测哪个项目：vision/projects/<名字>/。只有一个项目时可留空
QA_PROJECT=mono-capture
# 被测 App 的源码根目录（绝对路径）。框架独立成仓库后必须填；
# 只有「框架就在 App 仓库里」时才能靠 project.json 里的相对路径
QA_APP_SOURCE=

# 被测端：android / ios
QA_PLATFORM=android
# 设备来源：local（本地真机）/ cloud（云真机：优测 UBox / TestMu）
QA_DEVICE_SOURCE=local

# 采集端 API base（新服务器 DCP，含 /api/v1 后缀）
QA_API_BASE=http://118.196.119.225/api/v1
# 主站地址（新协议登录用）
QA_MAIN_SITE_HOST=https://app.molardata.com
# 服务器：new / legacy（两套账号体系互不相通）
QA_SERVER_ID=new
# 登录账号（真实密码只在本地 .env 里填，禁止提交）
QA_USERNAME=
QA_PASSWORD=

# ---- 安卓本地真机 ----
ANDROID_UDID=
ANDROID_APP_PACKAGE=com.apex.collect
ANDROID_APP_ACTIVITY=.MainActivity
# 可选：不装包时用 APK 路径启动（appium 会自动安装）
ANDROID_APK_PATH=

# ---- iOS 云真机（预留：UDID 由云平台下发，签名由平台处理）----
IOS_BUNDLE_ID=com.apex.collect
IOS_UDID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=iPhone Developer
# 可选：development 签名 ipa 路径（本地跑或给云平台重签用）
IOS_IPA_PATH=

# 留证目录（失败截图 / page_source / 日志 / appium server log）
EVIDENCE_DIR=./evidence

# ---- 黄金链路 ----
# 录制时长（QC 要求 ≥30 秒）
QA_GOLDEN_RECORD_SECONDS=35
# 视频验收规格
QA_VIDEO_WIDTH=1920
QA_VIDEO_HEIGHT=1080
QA_VIDEO_FPS=30
# QC 必填项：光线（单选）、工具（多选取一）、L2 具体场所、L3 具体操作
QA_QC_LIGHTING=自然光
QA_QC_TOOLS=无
QA_QC_L2=办公室
QA_QC_L3=整理货架

# 视觉回归：1 开启 / 0 关闭；容差为允许的差异像素占比
QA_VISION=1
QA_VISION_TOLERANCE=0.02
# 设为 1 时用本次截图覆盖基线（确认改动符合预期后再开）
QA_VISION_UPDATE=0

# 重试与超时预算（防止在真机上空转）
QA_MAX_SWIPES=6      # 找单个元素最多滑动次数
QA_MAX_ROUNDS=2      # 自适应补答/补填的轮数
QA_MAX_CANDIDATES=2  # 同一目标最多尝试几个候选文案
QA_STEP_TIMEOUT=60   # 单步总时长上限（秒）
QA_QC_TIMEOUT=150    # QC 填答整体预算（秒）
